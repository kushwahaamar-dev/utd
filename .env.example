# iynk server settings. Copy to .env.local and fill in what you have.
# Every variable is optional: a feature without its key shows "not set up on this deployment".
# Only NEXT_PUBLIC_* values reach the browser. Never commit real keys.

# NVIDIA API key from build.nvidia.com (Nemotron chat, tools, planning). Free tier is about 40 requests a minute.
NVIDIA_API_KEY=
# Optional self-hosted vLLM (OpenAI-compatible, e.g. http://host:8000/v1); tried first, the hosted API is the fallback.
NEMOTRON_BASE_URL=
# Fast model: lab partner and the agent executor.
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Planner and critic model.
NEMOTRON_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Vision model.
NEMOTRON_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# SerpApi key for live prices, places, events, videos and datasheets.
SERPAPI_KEY=
# Uncached SerpApi searches allowed per server process before refusing new ones.
SERPAPI_MONTHLY_BUDGET=200

# Server-side Solana RPC (devnet only).
SOLANA_RPC_URL=https://api.devnet.solana.com
# Issuer, fee payer and faucet treasury: a JSON array of 64 numbers (solana-keygen output). Devnet only.
SOLANA_ISSUER_KEYPAIR=
# Solana cluster shown to the browser; iynk only runs on devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Browser-side Solana RPC.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Deployed iynk_passport program id (solana/README.md).
NEXT_PUBLIC_SOLANA_PROGRAM_ID=

# Public origin for share links, the MCP connector and OpenAPI servers.
# Unset or blank: http://localhost:3000 (server code and share links built off the
# browser). A link built in the browser uses that page's origin. On a public
# deploy, set the https origin with no trailing slash before the build.
# NEXT_PUBLIC_* is inlined at build time and does not change on next start.
# Canonical, hreflang and metadataBase use siteUrl(), not this name: SITE_URL,
# else https://$VERCEL_PROJECT_PRODUCTION_URL, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vultr deploy scripts only (docs/DEPLOY.md); the app never reads these.
VULTR_API_KEY=
# The core VM's IP, printed by scripts/deploy-vultr-create.sh.
VULTR_HOST=
# Public hostname for Caddy's certificate. Blank: <VULTR_HOST>.sslip.io.
DOMAIN=
# Secret the module is published with; the worker registers with the same value. Use a long random string.
WORKER_SECRET=
# API key the GPU's vLLM server requires (scripts/deploy-vultr-gpu.sh).
VLLM_API_KEY=

# SpacetimeDB (the shared backend: rooms, laps, agent jobs, races). See src/lib/stdb/READY.md.
# Client: the WebSocket address and database name. Defaults are the local dev server.
# Production: wss://maincloud.spacetimedb.com and iynk-hackutd (scripts/publish-maincloud.sh).
NEXT_PUBLIC_STDB_URI=ws://127.0.0.1:3100
NEXT_PUBLIC_STDB_DB=iynk
# Module env vars are not read from .env: they are set on the database when you publish
# (WORKER_SECRET=... NVIDIA_API_KEY=... SERPAPI_KEY=... npm run stdb:publish). See spacetime/README.md.
# The agent worker reads these to log in as the worker identity.
STDB_URI=ws://127.0.0.1:3100
STDB_DB=iynk
STDB_WORKER_SECRET=dev-worker-secret

# Solana
# Worker only: the program id when it differs from NEXT_PUBLIC_SOLANA_PROGRAM_ID. SOLANA_ISSUER_KEYPAIR may be a JSON byte array or base58.
SOLANA_PROGRAM_ID=

# Nemotron agent worker (worker/README.md). Model ids, NVIDIA_API_KEY and NEMOTRON_BASE_URL are set above.
# Run the agents with no key at all: NEMOTRON_FAKE=1
NEMOTRON_FAKE=
# Hosted calls per minute shared by all jobs; the free tier allows about 40.
NEMOTRON_RPM=30
# Jobs the worker runs at once.
JOB_CONCURRENCY=2
# The worker logs in with STDB_URI, STDB_DB and STDB_WORKER_SECRET above.
