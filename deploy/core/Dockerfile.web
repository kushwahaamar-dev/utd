# The Next.js app as a standalone server. Build context: the repo root.
FROM node:24.22.1-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_STDB_URI NEXT_PUBLIC_STDB_DB NEXT_PUBLIC_SOLANA_PROGRAM_ID NEXT_PUBLIC_SOLANA_CLUSTER
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=standalone \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_STDB_URI=$NEXT_PUBLIC_STDB_URI \
    NEXT_PUBLIC_STDB_DB=$NEXT_PUBLIC_STDB_DB NEXT_PUBLIC_SOLANA_PROGRAM_ID=$NEXT_PUBLIC_SOLANA_PROGRAM_ID \
    NEXT_PUBLIC_SOLANA_CLUSTER=$NEXT_PUBLIC_SOLANA_CLUSTER
COPY package.json package-lock.json ./
COPY scripts/patch-deps.mjs scripts/
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:24.22.1-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/en').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "server.js"]
