{
  "name": "iynk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "content": "node -e \"const f='scripts/gen-content-index.mjs';if(require('fs').existsSync(f))require('child_process').execFileSync(process.execPath,[f],{stdio:'inherit'});else console.log('skipped: '+f+' is not written yet')\"",
    "content:check": "node scripts/gen-content-index.mjs --check",
    "predev": "npm run content",
    "dev": "next dev",
    "prebuild": "npm run content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --quiet",
    "typegen": "next typegen",
    "pretypecheck": "npm run content",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "npm run content",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run content:check && npm run typecheck && npm run lint && npm run test && npm run e2e",
    "stdb:start": "mkdir -p spacetime/.data && spacetime start --listen-addr 127.0.0.1:3100 --data-dir spacetime/.data",
    "stdb:build": "spacetime build -p spacetime",
    "stdb:publish": "WORKER_SECRET=${WORKER_SECRET:-dev-worker-secret} spacetime publish iynk --server http://127.0.0.1:3100 -p spacetime --yes",
    "stdb:reset": "WORKER_SECRET=${WORKER_SECRET:-dev-worker-secret} spacetime publish iynk --server http://127.0.0.1:3100 -p spacetime --delete-data=always --yes",
    "stdb:generate": "spacetime generate --lang typescript --out-dir src/lib/stdb/bindings -p spacetime --yes",
    "stdb:publish:maincloud": "bash scripts/publish-maincloud.sh",
    "stdb:logs": "spacetime logs iynk --server http://127.0.0.1:3100 -f",
    "stdb:test": "vitest run --root spacetime"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@coral-xyz/anchor": "0.31.1",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/hashes": "2.4.0",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "spacetimedb": "2.14.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.2",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
